{
  "id": "/",
  "name": "Fala",
  "short_name": "Fala",
  "description": "A SoundCloud front-end.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0c0e",
